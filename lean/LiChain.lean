/-! ## Positivity on each interval -/

/-- Gluing two overlapping ranges. -/
theorem glue (P : ℕ → Prop) (a b c : ℕ) (h1 : ∀ n, a ≤ n → n ≤ b → P n)
    (h2 : ∀ n, b ≤ n → n ≤ c → P n) : ∀ n, a ≤ n → n ≤ c → P n := by
  intro n ha hc
  rcases le_total n b with h | h
  · exact h1 n ha h
  · exact h2 n h hc

